@model IEnumerable<CRUD_OperationByMeUsingJqueryAjaxMvc.Models.Employee>



@{
    ViewBag.Title = "Index";
}

<a href="#" class="btn btn-info" style="margin-top:10px;" onclick="AddNewStudent(0)">Add New Student</a> <br /><br />



<table class="table table-striped table-condensed" id="employeeTable">
    <thead>
        <tr>
            <th>
                Name
            <th>
                Position
            </th>
            <th>
                Office
            </th>
            <th>
                Salary
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Position)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Office)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Salary)
                </td>
                <td>
                    <a class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-edit"></span></a>
                    <a class="btn btn-danger btn-sm" style="margin-left:3px"><span class="glyphicon glyphicon-trash"></span></a>
                </td>
            </tr>
        }
    </tbody>

</table>

@*Create a popup modal for Save & Edit a student*@
<div class="modal fade" id="Mymodal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <a href="#" class="close" data-dismiss="modal">&times;</a>
                <h4 id="ModalTitle"></h4>
            </div>
            <div class="modal-body">
                <form id="form">
                    <fieldset id="SubmitForm">
                        <input type="hidden" id="EmpId" />
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="EmpName" class="col-form-label">Name:</label>
                                    <input type="text" id="EmpName" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="EmpName" class="col-form-label">Position:</label>
                                    <input type="text" id="EmpPos" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="EmpName" class="col-form-label">Office:</label>
                                    <input type="text" id="EmpOfc" class="form-control" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="EmpSal" class="col-form-label">Salary:</label>
                                    <input type="text" id="EmpSal" class="form-control" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <a href="#" class="btn btn-block btn-primary" id="SaveStudentRecord">Save</a>
                        </div>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
</div>

<link href="https://cdn.datatables.net/1.10.20/css/jquery.dataTables.min.css" rel="stylesheet" />
@section scripts{
    @Scripts.Render("~/bundles/jqueryval")
    <script src="https://cdn.datatables.net/1.10.20/js/jquery.dataTables.min.js"></script>
    <script>
        function activatejQueryTable() {
            $("#employeeTable").DataTable();
        }

        $(function () {
            activatejQueryTable();
        });
    </script>

    <script>
        //Show the popup modal for Add new Student
        function AddNewStudent(StudentId) {
            $("#form")[0].reset();
            $("#ModalTitle").html("Add New Student");
            $("#Mymodal").modal();
        }
    </script>
}

<style>
    .form-control {
        width: 650px;
    }
</style>



