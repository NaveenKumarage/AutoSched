@section scripts{
    <script>

        $(document).ready(function () {
            GetEmployeeDetails();
        });

        //Get Employee Details
        function GetEmployeeDetails() {
            $.ajax({
                type: "Get",
                url: "/Profile/GetEmployeeDetails?EmployeeId=" + $("#EmpId").val(),
                success: function (result) {

                    //Profile Details
                    $("#txtEmployeeCode").val(result.dataList[0].EmployeeCode);
                    $("#txtEpfNo").val(result.dataList[0].EPFNo);
                    $("#txtFirstName").val(result.dataList[0].FirstName);
                    $("#txtLastName").val(result.dataList[0].LastName);
                    $("#txtInitials").val(result.dataList[0].NameWithInitial);
                    $("#txtFullName").val(result.dataList[0].FullName);
                    $("#txtCallName").val(result.dataList[0].CallName);
                    $("input[name=gender][value='" + result.dataList[0].Gender + "']").prop("checked", true).change();
                    $("input[name=status][value='" + result.dataList[0].Status + "']").prop("checked", true).change();
                    $('#single_cal1').data('daterangepicker').setStartDate(result.dataList[0].DateOfBirth);
                    $('#hEmployeeName').html(result.dataList[0].FirstName + " " + result.dataList[0].LastName);
                    $('#lblDesignation').html(result.dataList[0].DesignationName);

                    //Contact Details
                    $("#txtaddress").val(result.dataList[0].Address);
                    $("#txtPostalCode").val(result.dataList[0].PostalCode);
                    $("#txtContactNoMobile").val(result.dataList[0].MobileNo);
                    $("#txtContactNoHome").val(result.dataList[0].HomeContactNo);
                    $("#txtOfficeNo").val(result.dataList[0].OfficeContactNo);
                    $("#txtEmail").val(result.dataList[0].Email);
                    $("#txtNicNo").val(result.dataList[0].NIC);
                    $("#txtPassportNo").val(result.dataList[0].PassportNo);
                    if (result.dataList[0].PassPortExpiryDate != null) {
                        $('#dateExpiaryDate').daterangepicker({
                            singleDatePicker: true,
                            singleClasses: "picker_2",
                        }, function (start, end, label) {
                            console.log(start.toISOString(), end.toISOString(), label);
                        });
                        $('#dateExpiaryDate').data('daterangepicker').setStartDate(result.dataList[0].PassPortExpiryDate);
                        $('#dateExpiaryDate').data('daterangepicker').setEndDate(result.dataList[0].PassPortExpiryDate);
                    } else {
                        $('#dateExpiaryDate').daterangepicker({
                            singleDatePicker: true,
                            singleClasses: "picker_2",
                            autoUpdateInput: false
                        }, function (start, end, label) {
                            console.log(start.toISOString(), end.toISOString(), label);
                        });
                    }
                    $("#txtEmergancyContactPerson").val(result.dataList[0].EmergencyContactPerson);
                    $("#txtEmergancyContactNo").val(result.dataList[0].EmergencyContactNo);
                    $("#txtRelationship").val(result.dataList[0].RelationshipOfContactPerson);
                }
            })
        }

        function ShowImagePreview(imageUploader, previewImage) {
            if (imageUploader.files && imageUploader.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $(previewImage).attr('src', e.target.result);
                }
                reader.readAsDataURL(imageUploader.files[0]);
            }
        }

        $('#updateBtn').click(function () {
            alert(1);
            if (window.FormData !== undefined) {
                var fileUpload = $("#ImageUpload").get(0);
                var files = fileUpload.files;
                alert(files);
                // Create FormData object
                var fileData = new FormData();

                // Looping over all files and add it to FormData object
                for (var i = 0; i < files.length; i++) {
                    fileData.append(files[i].name, files[i]);
                }

                fileData.append('EmployeeId', $("#EmpId").val());
                fileData.append('FirstName', $("#txtFirstName").val());
                fileData.append('LastName', $("#txtLastName").val());
                fileData.append('Initials', $("#txtInitials").val());
                fileData.append('FullName', $("#txtFullName").val());
                fileData.append('CallName', $("#txtCallName").val());
                fileData.append('Gender', $('input[name="gender"]:checked').val());
                fileData.append('Status', $('input[name="status"]:checked').val());
                fileData.append('DateOfBirth', $("#single_cal1").val());
                fileData.append('Address', $("#txtaddress").val());
                fileData.append('PostalCode', $("#txtPostalCode").val());
                fileData.append('ContactNoMobile', $("#txtContactNoMobile").val());
                fileData.append('ContactNoHome', $("#txtContactNoHome").val());
                fileData.append('OfficeNo', $("#txtOfficeNo").val());
                fileData.append('Email', $("#txtEmail").val());
                fileData.append('NicNo', $('#txtNicNo').val());
                fileData.append('PassportNo', $('#txtPassportNo').val());
                fileData.append('PassportExpiaryDate', $("#dateExpiaryDate").val());
                fileData.append('EmergencyContactPerson', $('#txtEmergancyContactPerson').val());
                fileData.append('EmergencyContactNo', $("#txtEmergancyContactNo").val());
                fileData.append('Relationship', $("#txtRelationship").val());
                fileData.append('UserName', $("#UserName").val());

                $.ajax({
                    type: "Post",
                    url: "/Profile/UpdateProfileDetails",
                    contentType: false, // Not to set any content header
                    processData: false, // Not to process data
                    data: fileData,
                    success: function (result) {
                        if (result.success) {
                            $.notify(result.message, "success");
                            //ClearControl();
                        }
                        else {
                            $.notify(result.message, "error");
                        }
                    },
                })
            }
        })

        $('#resetBtn').click(function () {
            GetEmployeeDetails();
            $("#ImageUpload").val('');
        })

    </script>
}
